`line 121 "/home/toast/verif-diplom/ext/core-v-verif/lib/uvm_agents/uvma_debug/uvma_debug_agent.sv" 0
function void uvma_debug_agent_c::build_phase(uvm_phase phase);
   
   super.build_phase(phase);
   
   get_and_set_cfg  ();
   get_and_set_cntxt();
   retrieve_vif     ();
   create_components();
   
endfunction : build_phase


`line 133 "/home/toast/verif-diplom/ext/core-v-verif/lib/uvm_agents/uvma_debug/uvma_debug_agent.sv" 0
function void uvma_debug_agent_c::connect_phase(uvm_phase phase);
   
   super.connect_phase(phase);
   
   connect_sequencer_and_driver();
   connect_analysis_ports();
   
   if (cfg.cov_model_enabled) begin
      connect_cov_model();
   end
   if (cfg.trn_log_enabled) begin
      connect_trn_loggers();
   end
   
endfunction: connect_phase


