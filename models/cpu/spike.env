# spike.env - sourced by the build scripts to add the Spike processor model (cpu=spike) to a
# processor DUT's OCV model. Needs ocv/tools/get_spike.sh <target> first.
#   SPIKE_TARGET=host|aarch64 (default host)
_cpu=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
_sp=$_cpu/../../build/spike
_t=${SPIKE_TARGET:-host}
if [ -f "$_sp/$_t/build/libriscv.a" ]; then
    export CPU_SRCS="$_cpu/cpu_spike.cc"
    export CPU_CFLAGS="-DOCV_CPU_SPIKE"
    export MODEL_CXXFLAGS="-std=c++2a -O2 -I$_sp/$_t/build -I$_sp/src -I$_sp/src/riscv -I$_sp/src/softfloat -I$_cpu -I$_cpu/../../../scr1/sim/rvfi_coverif"
    export MODEL_LIBS="$_sp/$_t/build/libriscv.a $_sp/$_t/build/libdisasm.a $_sp/$_t/build/libsoftfloat.a $_sp/$_t/build/libfdt.a $_sp/$_t/build/libfesvr.a -ldl -lpthread"
else
    echo "spike.env: no Spike for $_t (run ocv/tools/get_spike.sh $_t) - cpu=spike not built in" >&2
fi
