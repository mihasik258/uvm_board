  function automatic logic op_is_branch(input fu_op op);
    unique case (op) inside
      EQ, NE, LTS, GES, LTU, GEU: return 1'b1;
      default:                    return 1'b0;   
    endcase
  endfunction

`line 555 "/home/toast/verif-diplom/ext/cva6/core/include/ariane_pkg.sv" 0
   
   
   
   
   
  function automatic logic is_rs1_fpr(input fu_op op);
    unique case (op) inside
      [FMUL : FNMADD],   
      FCVT_F2I,   
      FCVT_F2F,   
      FSGNJ,   
      FMV_F2X,   
      FCMP,   
      FCLASS,   
      [VFMIN : VFCPKCD_D],   
      ACCEL_OP_FS1:
      return 1'b1;   
      default: return 1'b0;   
    endcase
  endfunction

`line 576 "/home/toast/verif-diplom/ext/cva6/core/include/ariane_pkg.sv" 0
   
   
  function automatic logic is_rs2_fpr(input fu_op op);
    unique case (op) inside
      [FSD : FSB],   
      [FADD : FMIN_MAX],   
      [FMADD : FNMADD],   
      FCVT_F2F,   
      [FSGNJ : FMV_F2X],   
      FCMP,   
      [VFMIN : VFCPKCD_D]:
      return 1'b1;   
      default: return 1'b0;   
    endcase
  endfunction

