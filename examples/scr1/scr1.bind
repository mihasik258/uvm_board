# scr1.bind - SCR1 (scr1_top_axi, RV32IMC_MAX, with its TCM and timer) under OCV (gen/cpu_wrap.py).
# SCR1_SRC: another copy of scr1/src (fault injection).
name     scr1
core     scr1_top_axi
files    ${SCR1}/src/core.files     base=${SCR1}/src
files    ${SCR1}/src/axi_top.files  base=${SCR1}/src
rtl      ${SCR1}/src/core/cache/scr1_icache.sv ${SCR1}/src/core/cache/scr1_dcache.sv ${SCR1}/src/core/cache/scr1_cache_wrapper.sv
incdir   ${SCR1}/src/includes
define   SCR1_CFG_RV32IMC_MAX SCR1_RVFI_EN

clock    clk
reset    cpu_rst_n low
tie      pwrup_rst_n = rst_n
tie      rst_n       = rst_n
tie      test_rst_n  = 1'b1
bus      axi A io_axi_imem_ ro
bus      axi B io_axi_dmem_ dev
device   console 0xF0000000 0x10      # the SCR1 tests print here

memory   64K
latency                         # random memory delays (--model-opt lat=G,R)
boot     0x200
exit     0xF8
model    rv32imc_zicsr_zifencei_zicntr
gen      scr1
region   0x480000 64K                 # TCM (inside scr1_top_axi)
observed 0x490000 0xFFFFFFE0          # the timer: loads read what the core read
csr      0x301 0x40001104             # misa: RV32 I M C (read-only)
csr      0xF11 0
csr      0xF12 8
csr      0xF13 0x22011200

# every retired instruction (RVFI-lite, scr1_rvfi_lite.sv)
stream retire retire
    valid    = @rvfi_valid_o
    pc       = @rvfi_rec_o[31:0]
    pc_next  = @rvfi_rec_o[63:32]
    rd_wdata = @rvfi_rec_o[95:64]
    rd       = @rvfi_rec_o[100:96]
    trap     = @rvfi_rec_o[101]
