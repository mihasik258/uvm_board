{
  "name": "memsum",
  "module": "memsum",
  "clock": "clk",
  "reset": { "port": "rst_n", "active": "low" },
  "description": "Reactive demo IP: a bus master that reads memory word by word and returns a checksum. The memory is the reference model on the PS: it answers each read request while the IP waits (frozen).",
  "channels": [
    {
      "name": "cmd", "kind": "source", "valid": "s_cmd_valid", "ready": "s_cmd_ready", "depth": 256,
      "fields": [
        { "name": "addr", "port": "s_cmd_addr", "width": 32 },
        { "name": "len",  "port": "s_cmd_len",  "width": 16 }
      ]
    },
    {
      "name": "req", "kind": "sink", "valid": "m_req_valid", "ready": "m_req_ready", "depth": 1024,
      "fields": [
        { "name": "addr", "port": "m_req_addr", "width": 32 }
      ]
    },
    {
      "name": "rsp", "kind": "source", "valid": "s_rsp_valid", "ready": "s_rsp_ready", "depth": 16,
      "stream": true, "freeze_when_starved": true,
      "fields": [
        { "name": "data", "port": "s_rsp_data", "width": 32 }
      ]
    },
    {
      "name": "res", "kind": "sink", "valid": "m_res_valid", "ready": "m_res_ready", "depth": 256,
      "fields": [
        { "name": "sum",  "port": "m_res_sum",  "width": 32 },
        { "name": "addr", "port": "m_res_addr", "width": 32 },
        { "name": "len",  "port": "m_res_len",  "width": 16 },
        { "name": "wait", "port": "m_res_wait", "width": 32 }
      ]
    }
  ]
}
