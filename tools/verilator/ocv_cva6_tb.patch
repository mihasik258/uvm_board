+namespace {
+std::vector<VlCovergroupInst*>& covergroupInsts() {
+    static std::vector<VlCovergroupInst*> s_insts;
+    return s_insts;
+}
+}  // namespace
+
+VlCovergroupInst::VlCovergroupInst() { covergroupInsts().push_back(this); }
+VlCovergroupInst::VlCovergroupInst(const VlCovergroupInst&) { covergroupInsts().push_back(this); }
+VlCovergroupInst::~VlCovergroupInst() {
+    std::vector<VlCovergroupInst*>& v = covergroupInsts();
+    for (size_t i = v.size(); i-- > 0;) {
+        if (v[i] == this) {
+            v.erase(v.begin() + static_cast<long>(i));
+            break;
+        }
+    }
+}
+
+double VlCovergroupInst::coverage() const {
+    double sum = 0.0;
+    double n = 0.0;
+    for (const auto& part : m_parts) {
+        double covered = 0.0;
+        double total = 0.0;
+        part.second->coverageParts(covered, total);
+        if (total != 0.0) {
+            sum += 100.0 * covered / total;
+            n += 1.0;
+        }
+    }
+    return n != 0.0 ? sum / n : 100.0;
+}
+
+void VlCovergroupInst::report(std::ostream& os, bool parts) {
+    char buf[64];
+    for (const VlCovergroupInst* const ip : covergroupInsts()) {
+        if (!ip->m_type) continue;
+        std::string name = ip->m_name ? ip->m_name() : std::string{};
+        if (name.empty()) name = "-";
+        VL_SNPRINTF(buf, sizeof(buf), "%.4f", ip->coverage());
+        os << ip->m_type << " " << name << " " << buf << "\n";
+        if (!parts) continue;
+        for (const auto& part : ip->m_parts) {
+            double covered = 0.0;
+            double total = 0.0;
+            part.second->coverageParts(covered, total);
+            VL_SNPRINTF(buf, sizeof(buf), "%.0f/%.0f %.4f", covered, total,
+                        total != 0.0 ? 100.0 * covered / total : 100.0);
+            os << "  " << part.first << " " << buf << "\n";
+        }
+    }
+}
+
+// the report into a file (OCV builds: +ocv_cov_report=<file>, uvm/vlt/ocv_main.cpp - a weak reference
+// there, as a build without covergroups has no verilated_covergroup.cpp)
+extern "C" void vl_covergroup_report(const char* filename, int parts) {
+    std::ofstream os{filename};
+    VlCovergroupInst::report(os, parts != 0);
+}
