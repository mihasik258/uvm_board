`line 139 "/home/toast/verif-diplom/ext/core-v-verif/lib/uvm_agents/uvma_clknrst/cov/uvma_clknrst_cov_model.sv" 0
task uvma_clknrst_cov_model_c::run_phase(uvm_phase phase);
   
   super.run_phase(phase);
   
   if (cfg.enabled && cfg.cov_model_enabled) begin
      fork
          
         forever begin
            cntxt.sample_cfg_e.wait_trigger();
            sample_cfg();
         end
         
          
         forever begin
            cntxt.sample_cntxt_e.wait_trigger();
            sample_cntxt();
         end
         
          
         forever begin
            mon_trn_fifo.get(mon_trn);
            sample_mon_trn();
         end
         
          
         forever begin
            seq_item_fifo.get(seq_item);
            sample_seq_item();
         end
      join_none
   end
   
endtask : run_phase


